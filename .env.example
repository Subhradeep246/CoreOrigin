# Voia — privacy-first appointment-booking assistant
#
# Copy to .env.local and fill in. Never commit real values.
# There is intentionally NO database configuration: patient data lives only in
# the encrypted browser-local vault on the patient's own device.

# Public product configuration
APP_BASE_URL=
PRODUCT_MODE=

# Google AI Studio (server-only).
# GOOGLE_AI_MODEL must be the exact model id enabled on your account.
# GOOGLE_AI_MODE must be "paid": free-tier usage is blocked for patient conversations.
GEMINI_API_KEY=
GOOGLE_AI_MODEL=
GOOGLE_AI_MODE=paid

# Tavily public-provider discovery (server-only)
TAVILY_API_KEY=

# Twilio — used ONLY for Verify OTP and an optional generic SMS receipt
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Hospital scheduling adapter: manual_review | mock | fhir
# "mock" is refused when PRODUCT_MODE=production.
HOSPITAL_BOOKING_MODE=manual_review
