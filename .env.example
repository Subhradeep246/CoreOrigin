# Public product configuration
ELEVENLABS_AGENT_ID=agent_5501kx8wda1pendvh6xvme7fxn78
APP_BASE_URL=http://localhost:3000
PRODUCT_MODE=demo

# Local default: in-memory storage (no database setup).
# Set to libsql and provide DATABASE_URL only for persistent remote storage.
STORAGE_BACKEND=memory

# Optional persistent storage (Turso or local file)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Demo hospital booking SMS destination (defaults to +19297374257)
HOSPITAL_BOOKING_PHONE=+19297374257

# ElevenLabs (server-only; required for private WebRTC sessions and setup scripts)
ELEVENLABS_API_KEY=
ELEVENLABS_TOOL_SECRET_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOIA_TOOL_SECRET=

# Twilio (server-only)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURES=true

# Nimble provider search (server-only)
